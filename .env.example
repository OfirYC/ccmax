# Production: attach Railway PostgreSQL and use its private connection URL.
DATABASE_URL=
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000
# Generate once with: openssl rand -hex 32. Keep this key across deployments.
ENCRYPTION_KEY=
# Required on first start. No public registration or default admin password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=平台管理员
# Leave false in production. This explicitly enables a local embedded PostgreSQL.
ALLOW_LOCAL_DB=false
LOCAL_DB_PATH=.local/database
# Account/live usage synchronization interval (seconds). Daily billing and the
# 23:55–00:10 Beijing snapshot schedule run automatically without extra settings.
SYNC_INTERVAL_SECONDS=300
# No shared upstream credentials are shipped in the repository.
